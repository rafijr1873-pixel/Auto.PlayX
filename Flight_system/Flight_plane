local function CreateJoystick(nameTag, anchor, pos)
	local bg = Instance.new("Frame")
	bg.Name = nameTag.."BG"
	bg.Size = UDim2.new(0,140,0,140)
	bg.AnchorPoint = anchor
	bg.Position = pos
	bg.BackgroundColor3 = Color3.fromRGB(255,255,255)
	bg.BackgroundTransparency = 0.65
	bg.BorderSizePixel = 0
	bg.Active = true
	bg.Parent = gui
	Instance.new("UICorner", bg).CornerRadius = UDim.new(1,0)

	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.Size = UDim2.new(0,64,0,64)
	knob.AnchorPoint = Vector2.new(0.5,0.5)
	knob.Position = UDim2.new(0.5,0,0.5,0)
	knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
	knob.BackgroundTransparency = 0.15
	knob.Parent = bg
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1,0,0,18)
	label.Position = UDim2.new(0,0,1,4)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1,1,1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.Text = nameTag
	label.Parent = bg

	local joystick = {X=0, Y=0, _touch=nil, radius=70}

	local function updateKnob(inputPos)
		local center = bg.AbsolutePosition + bg.AbsoluteSize/2
		local delta = Vector2.new(inputPos.X, inputPos.Y) - center
		local dist = math.min(delta.Magnitude, joystick.radius)
		local dir = (delta.Magnitude>0) and delta.Unit or Vector2.new()
		local clamped = dir*dist
		knob.Position = UDim2.new(0.5, clamped.X, 0.5, clamped.Y)
		joystick.X = clamped.X/joystick.radius
		joystick.Y = -clamped.Y/joystick.radius
	end

	local function resetKnob()
		joystick._touch = nil
		joystick.X, joystick.Y = 0,0
		knob.Position = UDim2.new(0.5,0,0.5,0)
	end

	bg.InputBegan:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
			joystick._touch = input
			updateKnob(input.Position)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if joystick._touch == input then updateKnob(input.Position) end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if joystick._touch == input then resetKnob() end
	end)

	return joystick
end

