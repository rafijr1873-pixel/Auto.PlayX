--=====================================================================
-- 1. CONFIG (MUDAH DIUBAH)
--=====================================================================
local Config = {
	-- Speed / Throttle
	MaxSpeed      = 200,    -- kecepatan maksimum dari throttle 100%
	MinSpeed      = 20,    -- kecepatan minimum tetap maju walau throttle 0% (biar tetap kaya jet, gak berhenti total)
	AccelRate     = 45,    -- seberapa cepat speed naik menuju target (momentum akselerasi)
	DecelRate     = 35,    -- seberapa cepat speed turun menuju target (momentum deselerasi)

	-- Boost
	BoostSpeedBonus = 70,
	BoostDuration   = 2.5,
	BoostCooldown   = 7,

	-- Rotasi
	PitchRate = 60,   -- derajat/detik, joystick kanan (atas/bawah)
	YawRate   = 70,   -- derajat/detik, joystick kanan (kiri/kanan)
	RollRate  = 160,  -- derajat/detik, tombol roll kiri/kanan

	AngularAcceleration = 260, -- makin besar = makin responsif

	InvertPitch = false,
	InvertYaw   = false,
	InvertRoll  = false,
	StickDeadzone = 0.06,

	-- BodyGyro / BodyVelocity
	GyroP        = 9e4,
	GyroMaxTorque= Vector3.new(9e9,9e9,9e9),
	VelocityMaxForce = Vector3.new(9e9,9e9,9e9),

	-- Kamera (smooth TPS follow)
	CameraDistance   = 18,
	CameraHeight     = 6,
	CameraStiffness  = 8,
	CameraFOVBase    = 70,
	CameraFOVBoost   = 15,
}

--=====================================================================
-- 2. STATE
--=====================================================================
local OrientationCFrame = CFrame.new() -- rotasi murni (tidak menyimpan posisi)
local AngularVelocity   = Vector3.new(0,0,0)
local CurrentSpeed      = 0

local ThrottleValue = 0.5 -- 0..1

local State = {
	RollLeftBtn = false, RollRightBtn = false,
	BoostActive = false, BoostOnCooldown = false,
	BoostTimeLeft = 0, CooldownTimeLeft = 0,
}

local FlightActive = false
local character, humanoid, hrp
local bg, bv

--=====================================================================
-- 3. UTIL
--=====================================================================
local function clamp01(v) return math.clamp(v,0,1) end

local function approach(current, target, maxDelta, dt)
	local diff = target - current
	local maxChange = maxDelta*dt
	if math.abs(diff) <= maxChange then return target end
	return current + (diff>0 and 1 or -1)*maxChange
end

local function applyDeadzone(v)
	if math.abs(v) < Config.StickDeadzone then return 0 end
	return v
end

