--=====================================================================
-- 5. SETUP KARAKTER
--=====================================================================
local function teardownCharacter()
	FlightActive = false
	if hrp then hrp.Anchored = false end
	camera.CameraType = Enum.CameraType.Custom
end

local function setupCharacter(char)
	FlightActive = false
	character = char
	humanoid  = char:WaitForChild("Humanoid")
	hrp       = char:WaitForChild("HumanoidRootPart")

	humanoid.PlatformStand = true
	humanoid.AutoRotate    = false

	for _,part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end

	hrp.Anchored = true -- kontrol penuh via script, tidak ada gravity Roblox yang ikut campur

	JetCFrame  = hrp.CFrame
	VelocityDir = JetCFrame.LookVector
	CurrentSpeed = Config.StartSpeed
	AngularVelocity = Vector3.new(0,0,0)

	State.BoostActive = false
	State.BoostOnCooldown = false
	State.BoostTimeLeft = 0
	State.CooldownTimeLeft = 0

	camera.CameraType = Enum.CameraType.Scriptable

	humanoid.Died:Connect(teardownCharacter)

	FlightActive = true
end

player.CharacterAdded:Connect(setupCharacter)
player.CharacterRemoving:Connect(teardownCharacter)
if player.Character then
	setupCharacter(player.Character)
end

--=====================================================================
-- 6. BOOST LOGIC
--=====================================================================
local function updateBoost(dt)
	if State.BoostActive then
		State.BoostTimeLeft = State.BoostTimeLeft - dt
		if State.BoostTimeLeft <= 0 then
			State.BoostActive = false
			State.BoostOnCooldown = true
			State.CooldownTimeLeft = Config.BoostCooldown
		end
	elseif State.BoostOnCooldown then
		State.CooldownTimeLeft = State.CooldownTimeLeft - dt
		if State.CooldownTimeLeft <= 0 then
			State.BoostOnCooldown = false
			State.CooldownTimeLeft = 0
		end
	end

	if State.BoostActive then
		boostBtn.BackgroundColor3 = Color3.fromRGB(0,220,255)
		boostCooldownRing.Size = UDim2.new(State.BoostTimeLeft/Config.BoostDuration,0,0,6)
		boostCooldownRing.BackgroundColor3 = Color3.fromRGB(0,255,150)
	elseif State.BoostOnCooldown then
		boostBtn.BackgroundColor3 = Color3.fromRGB(60,60,60)
		boostCooldownRing.Size = UDim2.new(1-(State.CooldownTimeLeft/Config.BoostCooldown),0,0,6)
		boostCooldownRing.BackgroundColor3 = Color3.fromRGB(255,60,60)
	else
		boostBtn.BackgroundColor3 = Color3.fromRGB(0,140,220)
		boostCooldownRing.Size = UDim2.new(1,0,0,6)
		boostCooldownRing.BackgroundColor3 = Color3.fromRGB(0,255,150)
	end
end

--=====================================================================
-- 7. MAIN FLIGHT LOGIC (No Gravity, No Stall, Momentum-based)
--=====================================================================
local function updatePhysics(dt)
	if not FlightActive or not hrp or not hrp.Parent then return end

	updateBoost(dt)

	throttleFill.Position = UDim2.new(0,0,1-ThrottleValue,0)
	throttleFill.Size     = UDim2.new(1,0,ThrottleValue,0)
	throttlePctLabel.Text = string.format("%d%%", ThrottleValue*100)

	-- ===== Input =====
	local pitchInput = applyDeadzone(LeftStick.Y) * (Config.InvertPitch and -1 or 1)
	local yawInput   = applyDeadzone(LeftStick.X)
	local rollInput  = applyDeadzone(RightStick.X) * (Config.InvertRoll and -1 or 1)

	-- ===== Bank-to-turn: makin miring, makin nambah yaw otomatis (efek jet) =====
	local bankSin = JetCFrame.RightVector:Dot(Vector3.new(0,1,0))
	local bankYawBonus = -bankSin * Config.BankToTurnStrength

	local targetPitchRate = pitchInput * Config.MaxPitchRate
	local targetYawRate   = (yawInput * Config.MaxYawRate) + bankYawBonus
	local targetRollRate  = rollInput * Config.MaxRollRate

	AngularVelocity = Vector3.new(
		approach(AngularVelocity.X, targetPitchRate, Config.AngularAcceleration, dt),
		approach(AngularVelocity.Y, targetYawRate,   Config.AngularAcceleration, dt),
		approach(AngularVelocity.Z, targetRollRate,  Config.AngularAcceleration*1.4, dt)
	)

	-- ===== Apply rotasi =====
	local rotDelta = CFrame.Angles(
		math.rad(AngularVelocity.X)*dt,
		math.rad(AngularVelocity.Y)*dt,
		math.rad(-AngularVelocity.Z)*dt
	)
	JetCFrame = JetCFrame * rotDelta

	local forward = JetCFrame.LookVector

	-- ===== Speed dari Throttle (dengan inertia, tidak instan) =====
	local targetSpeed = ThrottleValue * Config.MaxSpeed
	if State.BoostActive then
		targetSpeed += Config.BoostSpeedBonus
	end

	local decelRate = Config.DecelRate
	if State.Airbrake then
		targetSpeed = 0
		decelRate = Config.DecelRate * Config.AirbrakeDecelMultiplier
	end

	if targetSpeed > CurrentSpeed then
		CurrentSpeed = approach(CurrentSpeed, targetSpeed, Config.AccelRate, dt)
	else
		CurrentSpeed = approach(CurrentSpeed, targetSpeed, decelRate, dt)
	end

	-- ===== Momentum arah gerak (jet-like drift/inertia saat belok) =====
	VelocityDir = VelocityDir:Lerp(forward, math.clamp(Config.VelocityAlignSpeed*dt, 0, 1))
	if VelocityDir.Magnitude > 0 then
		VelocityDir = VelocityDir.Unit
	end

	local velocity = VelocityDir * CurrentSpeed

	-- ===== Update posisi (tidak ada gravity, tidak ada jatuh) =====
	local newPos = JetCFrame.Position + velocity*dt
	JetCFrame = CFrame.new(newPos) * (JetCFrame - JetCFrame.Position)
	hrp.CFrame = JetCFrame

	-- ===== HUD =====
	speedLabel.Text = string.format("SPD %d", math.floor(CurrentSpeed))
	if State.BoostActive then
		boostLabel.Text = string.format("BOOST ACTIVE %.1fs", State.BoostTimeLeft)
	elseif State.BoostOnCooldown then
		boostLabel.Text = string.format("BOOST CD %.1fs", State.CooldownTimeLeft)
	else
		boostLabel.Text = "BOOST READY"
	end
end

--=====================================================================
-- 8. CAMERA -- SIMPLE SMOOTH TPS FOLLOW
--=====================================================================
local currentFOV = Config.CameraFOVBase

local function updateCamera(dt)
	if not FlightActive or not hrp or not hrp.Parent then return end

	local offset = Vector3.new(0, Config.CameraHeight, Config.CameraDistance)
	local camPos = JetCFrame.Position + JetCFrame:VectorToWorldSpace(offset)
	local lookAt = JetCFrame.Position

	local targetCFrame = CFrame.new(camPos, lookAt)
	camera.CFrame = camera.CFrame:Lerp(targetCFrame, math.clamp(Config.CameraStiffness*dt, 0, 1))

	local targetFOV = Config.CameraFOVBase + (State.BoostActive and Config.CameraFOVBoostBonus or 0)
	currentFOV = currentFOV + (targetFOV-currentFOV)*math.clamp(dt*3,0,1)
	camera.FieldOfView = currentFOV
end

--=====================================================================
-- 9. MAIN LOOP
--=====================================================================
RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 1/30)
	local ok, err = pcall(updatePhysics, dt)
	if not ok then warn("[JetFlight] physics error:", err) end
end)

RunService.RenderStepped:Connect(function(dt)
	local ok, err = pcall(updateCamera, dt)
	if not ok then warn("[JetFlight] camera error:", err) end
end)

print("[JetFlight] Flight system (No Gravity/Stall) aktif.")
