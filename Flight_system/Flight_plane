local Config = {
	-- Physics dasar
	Mass    = 1,
	Gravity = 70,

	-- Throttle / Thrust
	MaxThrust = 1600,

	-- Kecepatan
	MaxSpeed   = 220,
	StallSpeed = 55,
	MinFlightSpeed = 15,

	-- Boost (tap sekali -> aktif otomatis -> cooldown)
	BoostThrustMultiplier = 2.2,
	BoostMaxSpeedBonus    = 90,
	BoostDuration         = 2.2,
	BoostCooldown         = 7,

	-- Aerodinamika
	LiftCoefficient        = 3.0,
	DragCoefficient        = 0.0035,
	AirbrakeDragMultiplier = 4.0,
	CriticalAoA            = 20,
	StallAoA               = 32,

	-- ===== Kontrol rotasi (DIPERCEPAT biar gak lambat) =====
	MaxPitchRate        = 60,   -- sebelumnya 45
	MaxYawRate          = 75,   -- sebelumnya 30 -> sekarang jauh lebih cepat belok
	MaxRollRate         = 170,  -- sebelumnya 150
	AngularAcceleration = 340,  -- sebelumnya 200 -> respon lebih instan/tidak lag

	ControlAuthorityMinFactor = 0.45, -- sebelumnya 0.25 -> tetap gesit walau pelan
	VelocityAlignStrength     = 0.6,

	InvertPitch = false,
	InvertRoll  = false,

	StickDeadzone = 0.06,

	-- Kamera (simple smooth TPS)
	CameraDistance      = 20,
	CameraHeight        = 6,
	CameraStiffness     = 8,    -- makin besar makin cepat "nempel" ke pesawat
	CameraFOVBase       = 70,
	CameraFOVBoostBonus = 15,

	StartSpeed = 90,
}

