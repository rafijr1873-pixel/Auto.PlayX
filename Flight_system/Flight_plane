local function CreateButton(text, pos, size, color)
	local b = Instance.new("TextButton")
	b.Text = text
	b.Size = size or UDim2.new(0,72,0,72)
	b.Position = pos
	b.AnchorPoint = Vector2.new(0.5,0.5)
	b.BackgroundColor3 = color or Color3.fromRGB(50,50,50)
	b.BackgroundTransparency = 0.2
	b.TextColor3 = Color3.new(1,1,1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 14
	b.AutoButtonColor = true
	b.Parent = gui
	Instance.new("UICorner", b).CornerRadius = UDim.new(1,0)
	return b
end

local function bindHold(button, onDown, onUp)
	local pressing = false
	button.InputBegan:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
			if not pressing then
				pressing = true
				onDown()
			end
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
			if pressing then
				pressing = false
				onUp()
			end
		end
	end)
end

local function bindTap(button, onTap)
	button.Activated:Connect(onTap)
end

