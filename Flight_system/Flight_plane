--=====================================================================
-- 5. SETUP KARAKTER SEBAGAI "JET"
--=====================================================================
local function teardownCharacter()
	FlightActive = false
	if hrp then hrp.Anchored = false end
	camera.CameraType = Enum.CameraType.Custom
end

local function setupCharacter(char)
	FlightActive = false
	character = char
	humanoid  = char:WaitForChild("Humanoid")
	hrp       = char:WaitForChild("HumanoidRootPart")

	humanoid.PlatformStand = true
	humanoid.AutoRotate    = false

	for _,part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end

	hrp.Anchored = true

	JetCFrame = hrp.CFrame
	Velocity  = JetCFrame.LookVector * Config.StartSpeed
	AngularVelocity = Vector3.new(0,0,0)

	State.BoostActive = false
	State.BoostOnCooldown = false
	State.BoostTimeLeft = 0
	State.CooldownTimeLeft = 0
	State.StallAmount = 0

	camera.CameraType = Enum.CameraType.Scriptable

	humanoid.Died:Connect(teardownCharacter)

	FlightActive = true
end

player.CharacterAdded:Connect(setupCharacter)
player.CharacterRemoving:Connect(teardownCharacter)
if player.Character then
	setupCharacter(player.Character)
end

--=====================================================================
-- 6. BOOST LOGIC
--=====================================================================
local function updateBoost(dt)
	if State.BoostActive then
		State.BoostTimeLeft = State.BoostTimeLeft - dt
		if State.BoostTimeLeft <= 0 then
			State.BoostActive = false
			State.BoostOnCooldown = true
			State.CooldownTimeLeft = Config.BoostCooldown
		end
	elseif State.BoostOnCooldown then
		State.CooldownTimeLeft = State.CooldownTimeLeft - dt
		if State.CooldownTimeLeft <= 0 then
			State.BoostOnCooldown = false
			State.CooldownTimeLeft = 0
		end
	end

	if State.BoostActive then
		boostBtn.BackgroundColor3 = Color3.fromRGB(0,220,255)
		boostCooldownRing.Size = UDim2.new(State.BoostTimeLeft/Config.BoostDuration,0,0,6)
		boostCooldownRing.BackgroundColor3 = Color3.fromRGB(0,255,150)
	elseif State.BoostOnCooldown then
		boostBtn.BackgroundColor3 = Color3.fromRGB(60,60,60)
		boostCooldownRing.Size = UDim2.new(1-(State.CooldownTimeLeft/Config.BoostCooldown),0,0,6)
		boostCooldownRing.BackgroundColor3 = Color3.fromRGB(255,60,60)
	else
		boostBtn.BackgroundColor3 = Color3.fromRGB(0,140,220)
		boostCooldownRing.Size = UDim2.new(1,0,0,6)
		boostCooldownRing.BackgroundColor3 = Color3.fromRGB(0,255,150)
	end
end

--=====================================================================
-- 7. MAIN FLIGHT PHYSICS
--=====================================================================
local function updatePhysics(dt)
	if not FlightActive or not hrp or not hrp.Parent then return end

	updateBoost(dt)

	throttleFill.Position = UDim2.new(0,0,1-ThrottleValue,0)
	throttleFill.Size     = UDim2.new(1,0,ThrottleValue,0)
	throttlePctLabel.Text = string.format("%d%%", ThrottleValue*100)

	-- ===== INPUT =====
	local pitchInput = applyDeadzone(LeftStick.Y) * (Config.InvertPitch and -1 or 1)
	local yawInput   = applyDeadzone(LeftStick.X)

	local rollAnalog = applyDeadzone(RightStick.X) * (Config.InvertRoll and -1 or 1)
	local rollButton = 0
	if State.RollLeftBtn  then rollButton -= 1 end
	if State.RollRightBtn then rollButton += 1 end
	local rollInput = math.clamp(rollAnalog + rollButton, -1, 1)

	-- ===== Control authority =====
	local speed = Velocity.Magnitude
	local speedFactor = math.clamp(speed/Config.StallSpeed, Config.ControlAuthorityMinFactor, 1)
	local controlAuthority = speedFactor * (1 - State.StallAmount*0.8)

	local targetPitchRate = pitchInput * Config.MaxPitchRate * controlAuthority
	local targetYawRate   = yawInput   * Config.MaxYawRate   * controlAuthority
	local targetRollRate  = rollInput  * Config.MaxRollRate  * math.clamp(speedFactor+0.3,0,1)

	AngularVelocity = Vector3.new(
		approach(AngularVelocity.X, targetPitchRate, Config.AngularAcceleration, dt),
		approach(AngularVelocity.Y, targetYawRate,   Config.AngularAcceleration, dt),
		approach(AngularVelocity.Z, targetRollRate,  Config.AngularAcceleration*1.4, dt)
	)

	local rotDelta = CFrame.Angles(
		math.rad(AngularVelocity.X)*dt,
		math.rad(AngularVelocity.Y)*dt,
		math.rad(-AngularVelocity.Z)*dt
	)
	JetCFrame = JetCFrame * rotDelta

	local forward = JetCFrame.LookVector
	local up      = JetCFrame.UpVector

	-- ===== Thrust =====
	local baseThrust = ThrottleValue * Config.MaxThrust
	local boostThrust = State.BoostActive and (Config.MaxThrust*(Config.BoostThrustMultiplier-1)) or 0
	local thrustForce = forward * (baseThrust + boostThrust)

	-- ===== AoA & Stall =====
	local velDir = speed > 1 and Velocity.Unit or forward
	local aoaCos = math.clamp(forward:Dot(velDir), -1, 1)
	local aoaDeg = math.deg(math.acos(aoaCos))

	local stallAmount = 0
	if speed < Config.StallSpeed or aoaDeg > Config.CriticalAoA then
		local speedStall = math.clamp((Config.StallSpeed - speed)/Config.StallSpeed, 0, 1)
		local aoaStall   = math.clamp((aoaDeg - Config.CriticalAoA)/(Config.StallAoA - Config.CriticalAoA), 0, 1)
		stallAmount = math.clamp(math.max(speedStall, aoaStall), 0, 1)
	end
	State.StallAmount = stallAmount
	stallWarning.Visible = stallAmount > 0.4

	-- ===== Lift =====
	local aoaFactor = math.clamp(1 - (aoaDeg/Config.StallAoA), 0, 1)
	local liftMag = Config.LiftCoefficient * speed*speed * 0.001 * aoaFactor * (1 - stallAmount*0.9)
	local liftForce = up * liftMag

	-- ===== Drag =====
	local dragMag = Config.DragCoefficient * speed*speed
	if State.Airbrake then dragMag *= Config.AirbrakeDragMultiplier end
	local dragForce = speed > 0.1 and (-velDir*dragMag) or Vector3.zero

	-- ===== Gravity =====
	local gravityAccel = Vector3.new(0,-Config.Gravity,0)

	-- ===== Integrate =====
	local accel = (thrustForce + liftForce + dragForce)/Config.Mass + gravityAccel
	local prevVel = Velocity
	Velocity = Velocity + accel*dt

	State.GForce = ((Velocity-prevVel)/dt - gravityAccel).Magnitude / Config.Gravity

	-- ===== Weathervane stability =====
	if speed > 1 then
		local alignStrength = Config.VelocityAlignStrength * (1-stallAmount)
		local newDir = velDir:Lerp(forward, math.clamp(alignStrength*dt,0,1))
		if newDir.Magnitude > 0 then
			Velocity = newDir.Unit * Velocity.Magnitude
		end
	end

	-- ===== Clamp kecepatan =====
	local maxSpeedNow = Config.MaxSpeed + (State.BoostActive and Config.BoostMaxSpeedBonus or 0)
	local curSpeed = Velocity.Magnitude
	if curSpeed > maxSpeedNow then
		local newSpeed = curSpeed - (curSpeed-maxSpeedNow)*math.clamp(dt*3,0,1)
		Velocity = Velocity.Unit * newSpeed
	elseif curSpeed < Config.MinFlightSpeed and curSpeed > 0.01 then
		Velocity = Velocity.Unit * Config.MinFlightSpeed
	end

	-- ===== Update posisi =====
	local newPos = JetCFrame.Position + Velocity*dt
	JetCFrame = CFrame.new(newPos) * (JetCFrame - JetCFrame.Position)
	hrp.CFrame = JetCFrame

	-- ===== HUD =====
	speedLabel.Text = string.format("SPD %d", math.floor(Velocity.Magnitude))
	altLabel.Text   = string.format("ALT %d", math.floor(newPos.Y))
	gLabel.Text     = string.format("G   %.1f", State.GForce)
	if State.BoostActive then
		boostLabel.Text = string.format("BOOST ACTIVE %.1fs", State.BoostTimeLeft)
	elseif State.BoostOnCooldown then
		boostLabel.Text = string.format("BOOST CD %.1fs", State.CooldownTimeLeft)
	else
		boostLabel.Text = "BOOST READY"
	end
end

--=====================================================================
-- 8. CAMERA -- SIMPLE SMOOTH TPS FOLLOW (sesuai request terbaru)
--=====================================================================
local currentFOV = Config.CameraFOVBase

local function updateCamera(dt)
	if not FlightActive or not hrp or not hrp.Parent then return end

	-- Posisi kamera: di belakang & sedikit di atas pesawat, mengikuti orientasi pesawat
	local offset = Vector3.new(0, Config.CameraHeight, Config.CameraDistance)
	local camPos = JetCFrame.Position + JetCFrame:VectorToWorldSpace(offset)
	local lookAt = JetCFrame.Position

	local targetCFrame = CFrame.new(camPos, lookAt)

	-- Smooth follow (Lerp) -- tidak ada shake, simpel & halus
	camera.CFrame = camera.CFrame:Lerp(targetCFrame, math.clamp(Config.CameraStiffness*dt, 0, 1))

	-- FOV: normal, membesar dikit hanya saat boost aktif
	local targetFOV = Config.CameraFOVBase + (State.BoostActive and Config.CameraFOVBoostBonus or 0)
	currentFOV = currentFOV + (targetFOV-currentFOV)*math.clamp(dt*3,0,1)
	camera.FieldOfView = currentFOV
end

--=====================================================================
-- 9. MAIN LOOP
--=====================================================================
RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 1/30)
	local ok, err = pcall(updatePhysics, dt)
	if not ok then warn("[JetFlight] physics error:", err) end
end)

RunService.RenderStepped:Connect(function(dt)
	local ok, err = pcall(updateCamera, dt)
	if not ok then warn("[JetFlight] camera error:", err) end
end)

