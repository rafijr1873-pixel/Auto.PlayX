--=====================================================================
-- JET-STYLE FLIGHT ENGINE (BodyGyro + BodyVelocity based)
-- Diadaptasi dari fly engine klasik, dibuat "maju terus" seperti jet
-- LocalScript - taruh di StarterPlayerScripts
--=====================================================================

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

--=====================================================================
-- 1. CONFIG (MUDAH DIUBAH)
--=====================================================================
local Config = {
	CruiseSpeed   = 60,     -- kecepatan jelajah konstan (jet selalu maju)
	SpeedRampRate = 40,     -- seberapa cepat speed naik dari 0 -> CruiseSpeed saat spawn (momentum awal)

	PitchRate = 50,   -- derajat/detik, dari joystick kiri (atas/bawah)
	YawRate   = 60,   -- derajat/detik, dari joystick kiri (kiri/kanan)
	RollRate  = 150,  -- derajat/detik, dari joystick kanan (miring)

	AngularAcceleration = 260, -- makin besar = makin responsif, makin kecil = makin "berat"/momentum kuat

	InvertPitch = false,
	InvertRoll  = false,
	StickDeadzone = 0.06,

	-- BodyGyro / BodyVelocity settings (sama filosofi seperti engine asli)
	GyroP        = 9e4,
	GyroMaxTorque= Vector3.new(9e9,9e9,9e9),
	VelocityMaxForce = Vector3.new(9e9,9e9,9e9),

	-- Kamera (smooth TPS follow sederhana)
	CameraDistance  = 18,
	CameraHeight    = 6,
	CameraStiffness = 8,
	CameraFOV       = 70,
}

--=====================================================================
-- 2. STATE
--=====================================================================
local JetCFrame       = CFrame.new() -- orientasi target (akumulasi rotasi dari input)
local AngularVelocity = Vector3.new(0,0,0) -- pitch,yaw,roll (deg/s), untuk inertia rotasi
local CurrentSpeed    = 0

local FlightActive = false
local character, humanoid, hrp
local bg, bv -- BodyGyro, BodyVelocity

--=====================================================================
-- 3. UTIL
--=====================================================================
local function approach(current, target, maxDelta, dt)
	local diff = target - current
	local maxChange = maxDelta*dt
	if math.abs(diff) <= maxChange then return target end
	return current + (diff>0 and 1 or -1)*maxChange
end

local function applyDeadzone(v)
	if math.abs(v) < Config.StickDeadzone then return 0 end
	return v
end

--=====================================================================
-- 4. BUILD UI -- HANYA 2 JOYSTICK (sesuai request, GUI dibuat sendiri)
--=====================================================================
local gui = Instance.new("ScreenGui")
gui.Name = "JetFlightControls"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function CreateJoystick(nameTag, anchor, pos)
	local bg_ = Instance.new("Frame")
	bg_.Name = nameTag.."BG"
	bg_.Size = UDim2.new(0,140,0,140)
	bg_.AnchorPoint = anchor
	bg_.Position = pos
	bg_.BackgroundColor3 = Color3.fromRGB(255,255,255)
	bg_.BackgroundTransparency = 0.65
	bg_.BorderSizePixel = 0
	bg_.Active = true
	bg_.Parent = gui
	Instance.new("UICorner", bg_).CornerRadius = UDim.new(1,0)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0,64,0,64)
	knob.AnchorPoint = Vector2.new(0.5,0.5)
	knob.Position = UDim2.new(0.5,0,0.5,0)
	knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
	knob.BackgroundTransparency = 0.15
	knob.Parent = bg_
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1,0,0,18)
	label.Position = UDim2.new(0,0,1,4)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1,1,1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.Text = nameTag
	label.Parent = bg_

	local joystick = {X=0, Y=0, _touch=nil, radius=70}

	local function updateKnob(inputPos)
		local center = bg_.AbsolutePosition + bg_.AbsoluteSize/2
		local delta = Vector2.new(inputPos.X, inputPos.Y) - center
		local dist = math.min(delta.Magnitude, joystick.radius)
		local dir = (delta.Magnitude>0) and delta.Unit or Vector2.new()
		local clamped = dir*dist
		knob.Position = UDim2.new(0.5, clamped.X, 0.5, clamped.Y)
		joystick.X = clamped.X/joystick.radius
		joystick.Y = -clamped.Y/joystick.radius
	end

	local function resetKnob()
		joystick._touch = nil
		joystick.X, joystick.Y = 0,0
		knob.Position = UDim2.new(0.5,0,0.5,0)
	end

	bg_.InputBegan:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
			joystick._touch = input
			updateKnob(input.Position)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if joystick._touch == input then updateKnob(input.Position) end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if joystick._touch == input then resetKnob() end
	end)

	return joystick
end

-- Joystick KIRI: yaw (kiri/kanan) + pitch (atas/bawah) -- kaya belok player biasa
local LeftStick  = CreateJoystick("BELOK (Pitch/Yaw)", Vector2.new(0,1), UDim2.new(0,120,1,-30))
-- Joystick KANAN: hanya miring/roll
local RightStick = CreateJoystick("MIRING (Roll)", Vector2.new(1,1), UDim2.new(1,-120,1,-30))

--=====================================================================
-- 5. SETUP KARAKTER + ENGINE (BodyGyro + BodyVelocity, seperti fly script asli)
--=====================================================================
local function cleanupEngine()
	if bg then bg:Destroy(); bg = nil end
	if bv then bv:Destroy(); bv = nil end
	if humanoid then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true
	end
	local anim = character and character:FindFirstChild("Animate")
	if anim then anim.Disabled = false end
	FlightActive = false
	camera.CameraType = Enum.CameraType.Custom
end

local function setupCharacter(char)
	FlightActive = false
	character = char
	humanoid  = char:WaitForChild("Humanoid")
	hrp       = char:WaitForChild("HumanoidRootPart")

	humanoid.PlatformStand = true
	humanoid.AutoRotate    = false

	-- disable animasi (biar gak kaya jalan/lari pas terbang) -- sama seperti engine asli
	local anim = char:FindFirstChild("Animate")
	if anim then anim.Disabled = true end

	-- ===== BodyGyro & BodyVelocity (INTI ENGINE, diambil dari fly script asli) =====
	bg = Instance.new("BodyGyro")
	bg.Parent = hrp
	bg.P = Config.GyroP
	bg.MaxTorque = Config.GyroMaxTorque
	bg.CFrame = hrp.CFrame

	bv = Instance.new("BodyVelocity")
	bv.Parent = hrp
	bv.MaxForce = Config.VelocityMaxForce
	bv.Velocity = Vector3.new(0,0,0)

	JetCFrame = hrp.CFrame
	AngularVelocity = Vector3.new(0,0,0)
	CurrentSpeed = 0 -- mulai dari 0, akan ramp up ke CruiseSpeed (momentum awal seperti jet lepas landas)

	camera.CameraType = Enum.CameraType.Scriptable

	humanoid.Died:Connect(cleanupEngine)

	FlightActive = true
end

player.CharacterAdded:Connect(setupCharacter)
player.CharacterRemoving:Connect(cleanupEngine)
if player.Character then
	setupCharacter(player.Character)
end

--=====================================================================
-- 6. MAIN ENGINE LOOP (adaptasi dari BodyGyro/BodyVelocity fly engine asli)
--=====================================================================
local function updateFlight(dt)
	if not FlightActive or not hrp or not hrp.Parent or not bg or not bv then return end

	-- ===== Input =====
	local pitchInput = applyDeadzone(LeftStick.Y) * (Config.InvertPitch and -1 or 1)
	local yawInput   = applyDeadzone(LeftStick.X)
	local rollInput  = applyDeadzone(RightStick.X) * (Config.InvertRoll and -1 or 1)

	local targetPitchRate = pitchInput * Config.PitchRate
	local targetYawRate   = yawInput   * Config.YawRate
	local targetRollRate  = rollInput  * Config.RollRate

	-- ===== Inertia rotasi (momentum, sama filosofi seperti speed ramp di engine asli) =====
	AngularVelocity = Vector3.new(
		approach(AngularVelocity.X, targetPitchRate, Config.AngularAcceleration, dt),
		approach(AngularVelocity.Y, targetYawRate,   Config.AngularAcceleration, dt),
		approach(AngularVelocity.Z, targetRollRate,  Config.AngularAcceleration*1.3, dt)
	)

	-- ===== Akumulasi orientasi target =====
	local rotDelta = CFrame.Angles(
		math.rad(AngularVelocity.X)*dt,
		math.rad(AngularVelocity.Y)*dt,
		math.rad(-AngularVelocity.Z)*dt
	)
	JetCFrame = JetCFrame * rotDelta

	-- ===== Speed ramp (momentum maju, seperti engine asli: speed = speed + .5 dst) =====
	CurrentSpeed = approach(CurrentSpeed, Config.CruiseSpeed, Config.SpeedRampRate, dt)

	-- ===== Apply ke BodyGyro & BodyVelocity (INI ENGINE INTINYA) =====
	bg.CFrame = JetCFrame
	bv.Velocity = JetCFrame.LookVector * CurrentSpeed
end

--=====================================================================
-- 7. CAMERA -- SIMPLE SMOOTH TPS FOLLOW
--=====================================================================
local function updateCamera(dt)
	if not FlightActive or not hrp or not hrp.Parent then return end

	local offset = Vector3.new(0, Config.CameraHeight, Config.CameraDistance)
	local camPos = JetCFrame.Position + JetCFrame:VectorToWorldSpace(offset)
	local lookAt = hrp.Position

	local targetCFrame = CFrame.new(camPos, lookAt)
	camera.CFrame = camera.CFrame:Lerp(targetCFrame, math.clamp(Config.CameraStiffness*dt, 0, 1))
	camera.FieldOfView = Config.CameraFOV
end

--=====================================================================
-- 8. MAIN LOOP
--=====================================================================
RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 1/30)
	local ok, err = pcall(updateFlight, dt)
	if not ok then warn("[JetEngine] error:", err) end
end)

RunService.RenderStepped:Connect(function(dt)
	local ok, err = pcall(updateCamera, dt)
	if not ok then warn("[JetEngine] camera error:", err) end
end)

print("[JetEngine] Aktif - BodyGyro/BodyVelocity jet engine.")
