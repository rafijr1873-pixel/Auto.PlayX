--=====================================================================
-- JET-STYLE FLIGHT SYSTEM (MOBILE/TOUCH) - No Gravity, No Stall
-- Seperti fly script biasa, tapi dengan momentum/inertia ala jet
-- LocalScript - taruh di StarterPlayerScripts
--=====================================================================

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

--=====================================================================
-- 1. CONFIG (SEMUA PARAMETER MUDAH DIUBAH DI SINI)
--=====================================================================
local Config = {
	-- Kecepatan & Throttle
	MaxSpeed     = 140,   -- kecepatan maksimum normal
	StartSpeed   = 50,
	AccelRate    = 90,    -- seberapa cepat speed naik menuju target (inertia akselerasi)
	DecelRate    = 70,    -- seberapa cepat speed turun menuju target (inertia deselerasi)
	AirbrakeDecelMultiplier = 3.5,

	-- Momentum arah (jet-like drift): makin kecil = makin "berat"/lambat berubah arah
	VelocityAlignSpeed = 3.2, -- per detik, seberapa cepat arah gerak menyusul arah hidung

	-- Boost
	BoostSpeedBonus = 90,   -- tambahan MaxSpeed sementara saat boost
	BoostDuration   = 2.2,
	BoostCooldown   = 7,

	-- Kontrol rotasi (derajat/detik)
	MaxPitchRate        = 65,
	MaxYawRate           = 80,
	MaxRollRate          = 180,
	AngularAcceleration  = 380, -- makin besar = makin responsif (tidak lag)

	-- Efek jet: rolling menyebabkan sedikit yaw otomatis (bank-to-turn), 0 = matikan
	BankToTurnStrength = 22,

	InvertPitch = false,
	InvertRoll  = false,
	StickDeadzone = 0.06,

	-- Kamera (simple smooth TPS)
	CameraDistance      = 20,
	CameraHeight        = 6,
	CameraStiffness     = 8,
	CameraFOVBase       = 70,
	CameraFOVBoostBonus = 15,
}

--=====================================================================
-- 2. STATE
--=====================================================================
local JetCFrame       = CFrame.new()
local VelocityDir      = Vector3.new(0,0,-1) -- arah gerak aktual (punya momentum sendiri)
local CurrentSpeed      = 0
local AngularVelocity   = Vector3.new(0,0,0)

local State = {
	Airbrake = false,
	BoostActive = false, BoostOnCooldown = false,
	BoostTimeLeft = 0, CooldownTimeLeft = 0,
}

local ThrottleValue = 0.35
local FlightActive  = false

local humanoid, hrp, character

--=====================================================================
-- 3. UTIL
--=====================================================================
local function clamp01(v) return math.clamp(v,0,1) end

local function approach(current, target, maxDelta, dt)
	local diff = target - current
	local maxChange = maxDelta*dt
	if math.abs(diff) <= maxChange then return target end
	return current + (diff>0 and 1 or -1)*maxChange
end

local function applyDeadzone(v)
	if math.abs(v) < Config.StickDeadzone then return 0 end
	return v
end

