local throttleTouch = nil
local function setThrottleFromPos(inputPos)
	local rel = 1 - clamp01((inputPos.Y - throttleTrack.AbsolutePosition.Y)/throttleTrack.AbsoluteSize.Y)
	ThrottleValue = clamp01(rel)
end
throttleTrack.InputBegan:Connect(function(input)
	if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
		throttleTouch = input
		setThrottleFromPos(input.Position)
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if throttleTouch == input then setThrottleFromPos(input.Position) end
end)
UserInputService.InputEnded:Connect(function(input)
	if throttleTouch == input then throttleTouch = nil end
end)

