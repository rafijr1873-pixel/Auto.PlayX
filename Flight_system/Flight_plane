--=====================================================================
-- 5. SETUP KARAKTER + ENGINE (BodyGyro + BodyVelocity)
--=====================================================================
local function cleanupEngine()
	if bg then bg:Destroy(); bg = nil end
	if bv then bv:Destroy(); bv = nil end
	if humanoid then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true
	end
	local anim = character and character:FindFirstChild("Animate")
	if anim then anim.Disabled = false end
	FlightActive = false
	camera.CameraType = Enum.CameraType.Custom
end

local function setupCharacter(char)
	FlightActive = false
	character = char
	humanoid  = char:WaitForChild("Humanoid")
	hrp       = char:WaitForChild("HumanoidRootPart")

	humanoid.PlatformStand = true
	humanoid.AutoRotate    = false

	local anim = char:FindFirstChild("Animate")
	if anim then anim.Disabled = true end

	bg = Instance.new("BodyGyro")
	bg.Parent = hrp
	bg.P = Config.GyroP
	bg.MaxTorque = Config.GyroMaxTorque
	bg.CFrame = hrp.CFrame

	bv = Instance.new("BodyVelocity")
	bv.Parent = hrp
	bv.MaxForce = Config.VelocityMaxForce
	bv.Velocity = Vector3.new(0,0,0)

	-- Ambil rotasi murni dari orientasi awal karakter (posisi diabaikan, akan selalu diambil ulang dari hrp.Position tiap frame)
	OrientationCFrame = hrp.CFrame - hrp.CFrame.Position
	AngularVelocity = Vector3.new(0,0,0)
	CurrentSpeed = Config.MinSpeed

	camera.CameraType = Enum.CameraType.Scriptable

	humanoid.Died:Connect(cleanupEngine)

	FlightActive = true
end

player.CharacterAdded:Connect(setupCharacter)
player.CharacterRemoving:Connect(cleanupEngine)
if player.Character then
	setupCharacter(player.Character)
end

--=====================================================================
-- 6. BOOST LOGIC
--=====================================================================
local function updateBoost(dt)
	if State.BoostActive then
		State.BoostTimeLeft -= dt
		if State.BoostTimeLeft <= 0 then
			State.BoostActive = false
			State.BoostOnCooldown = true
			State.CooldownTimeLeft = Config.BoostCooldown
		end
	elseif State.BoostOnCooldown then
		State.CooldownTimeLeft -= dt
		if State.CooldownTimeLeft <= 0 then
			State.BoostOnCooldown = false
		end
	end

	if State.BoostActive then
		boostBtn.BackgroundColor3 = Color3.fromRGB(0,220,255)
		boostCooldownRing.Size = UDim2.new(State.BoostTimeLeft/Config.BoostDuration,0,0,6)
		boostCooldownRing.BackgroundColor3 = Color3.fromRGB(0,255,150)
	elseif State.BoostOnCooldown then
		boostBtn.BackgroundColor3 = Color3.fromRGB(60,60,60)
		boostCooldownRing.Size = UDim2.new(1-(State.CooldownTimeLeft/Config.BoostCooldown),0,0,6)
		boostCooldownRing.BackgroundColor3 = Color3.fromRGB(255,60,60)
	else
		boostBtn.BackgroundColor3 = Color3.fromRGB(0,140,220)
		boostCooldownRing.Size = UDim2.new(1,0,0,6)
		boostCooldownRing.BackgroundColor3 = Color3.fromRGB(0,255,150)
	end
end

--=====================================================================
-- 7. MAIN ENGINE LOOP
--=====================================================================
local function updateFlight(dt)
	if not FlightActive or not hrp or not hrp.Parent or not bg or not bv then return end

	updateBoost(dt)

	-- ===== UI Update =====
	throttleFill.Position = UDim2.new(0,0,1-ThrottleValue,0)
	throttleFill.Size     = UDim2.new(1,0,ThrottleValue,0)
	throttlePctLabel.Text = string.format("%d%%", ThrottleValue*100)

	-- ===== Input =====
	local pitchInput = applyDeadzone(TurnStick.Y) * (Config.InvertPitch and -1 or 1)
	local yawInput   = applyDeadzone(TurnStick.X) * (Config.InvertYaw and -1 or 1)

	local rollInput = 0
	if State.RollLeftBtn  then rollInput -= 1 end
	if State.RollRightBtn then rollInput += 1 end
	rollInput = rollInput * (Config.InvertRoll and -1 or 1)

	local targetPitchRate = pitchInput * Config.PitchRate
	local targetYawRate   = yawInput   * Config.YawRate
	local targetRollRate  = rollInput  * Config.RollRate

	-- ===== Inertia rotasi =====
	AngularVelocity = Vector3.new(
		approach(AngularVelocity.X, targetPitchRate, Config.AngularAcceleration, dt),
		approach(AngularVelocity.Y, targetYawRate,   Config.AngularAcceleration, dt),
		approach(AngularVelocity.Z, targetRollRate,  Config.AngularAcceleration*1.3, dt)
	)

	-- ===== Akumulasi rotasi (FIX: yaw arah dibalik supaya kanan = belok kanan) =====
	local rotDelta = CFrame.Angles(
		math.rad(AngularVelocity.X)*dt,
		math.rad(-AngularVelocity.Y)*dt,  -- <- FIX arah yaw
		math.rad(-AngularVelocity.Z)*dt
	)
	OrientationCFrame = OrientationCFrame * rotDelta

	-- ===== Speed dari Throttle + Boost (dengan momentum) =====
	local baseTarget = Config.MinSpeed + ThrottleValue * (Config.MaxSpeed - Config.MinSpeed)
	local targetSpeed = baseTarget + (State.BoostActive and Config.BoostSpeedBonus or 0)

	if targetSpeed > CurrentSpeed then
		CurrentSpeed = approach(CurrentSpeed, targetSpeed, Config.AccelRate, dt)
	else
		CurrentSpeed = approach(CurrentSpeed, targetSpeed, Config.DecelRate, dt)
	end

	-- ===== Apply ke BodyGyro & BodyVelocity =====
	-- Selalu ambil posisi ASLI karakter (fix kamera & rotasi supaya tidak "ketinggalan")
	bg.CFrame = CFrame.new(hrp.Position) * OrientationCFrame
	bv.Velocity = OrientationCFrame.LookVector * CurrentSpeed

	-- ===== HUD =====
	speedLabel.Text = string.format("SPD %d", math.floor(CurrentSpeed))
	if State.BoostActive then
		boostLabel.Text = string.format("BOOST ACTIVE %.1fs", State.BoostTimeLeft)
	elseif State.BoostOnCooldown then
		boostLabel.Text = string.format("BOOST CD %.1fs", State.CooldownTimeLeft)
	else
		boostLabel.Text = "BOOST READY"
	end
end

--=====================================================================
-- 8. CAMERA -- FIX: selalu ambil posisi ASLI karakter tiap frame
--=====================================================================
local currentFOV = Config.CameraFOVBase

local function updateCamera(dt)
	if not FlightActive or not hrp or not hrp.Parent then return end

	local forward = OrientationCFrame.LookVector
	local up      = OrientationCFrame.UpVector

	-- Selalu pakai hrp.Position TERKINI (bukan posisi lama) -> ini FIX kamera tidak mengikuti
	local camPos = hrp.Position - forward*Config.CameraDistance + up*Config.CameraHeight
	local lookAt = hrp.Position + forward*10

	local targetCFrame = CFrame.new(camPos, lookAt)
	camera.CFrame = camera.CFrame:Lerp(targetCFrame, math.clamp(Config.CameraStiffness*dt, 0, 1))

	local targetFOV = Config.CameraFOVBase + (State.BoostActive and Config.CameraFOVBoost or 0)
	currentFOV = currentFOV + (targetFOV-currentFOV)*math.clamp(dt*3,0,1)
	camera.FieldOfView = currentFOV
end

--=====================================================================
-- 9. MAIN LOOP
--=====================================================================
RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 1/30)
	local ok, err = pcall(updateFlight, dt)
	if not ok then warn("[JetEngine] error:", err) end
end)

RunService.RenderStepped:Connect(function(dt)
	local ok, err = pcall(updateCamera, dt)
	if not ok then warn("[JetEngine] camera error:", err) end
end)

print("[JetEngine] v2 aktif - fixed turn direction & camera follow.")
